// archive on its own; Zulu GO installs into a subfolder, where it does not.
#define ZULU_PRODUCT_MOD_BIG_NAME            "@ZULU_PRODUCT_MOD_BIG_NAME@"

// 1 when the NSIS /D= target directory is the PARENT of the launcher's own
// directory. Zulu's launcher sits in the install root, so /D= is its own
