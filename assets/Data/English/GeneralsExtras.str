// ScoreScreen.wnd column headers. Each cell stacks a raw count on top of
// the dollar-value aggregate ($X.XXk with a percent delta from the column
// average), so the headers stay short and the "$" in the value line
// disambiguates which number is which.
GUI:ScoreUnitBuilt
"Units Built"
END

GUI:ScoreUnitLost
"Units Lost"
END

GUI:ScoreUnitKilled
"Units Killed"
END

GUI:ScoreBldgBuilt
"Buildings Built"
END

GUI:ScoreBldgLost
"Buildings Lost"
END

GUI:ScoreBldgKilled
"Buildings Killed"
END

// Repurposes the retail-vestigial Score column to show
// (value killed) / (income) * 100, or "-" when no income was earned.
GUI:ScoreEfficiency
"Efficiency"
END

// LAN lobby "Enforce Random" checkbox: while checked, the host locks every
// occupied slot's faction and team to Random (color stays selectable). The
// Randomize button can still assign concrete factions/teams afterwards.
GUI:EnforceRandom
"Enforce Random"
END

TOOLTIP:EnforceRandom
"Lock all players to random faction, team and start position"
END

GUI:FFAMode
"FFA Mode"
END

TOOLTIP:FFAMode
"Hide who is who: names lose their colors and hovering a unit does not show its owner. Players still pick their own colors and factions."
END

// Quit button on the multiplayer load screen: leaves a game a peer is never going to
// finish loading, instead of waiting out the load timeout.
GUI:LoadScreenQuit
"QUIT"
END

// Observer info panel rows. The stock strings ("Units Destroyed", "Units Lost") wrap onto a
// second line inside the panel's one-line rows, so the panel uses these short labels instead.
CONTROLBAR:ObsLabelUnits
"Units"
END

CONTROLBAR:ObsLabelBuildings
"Buildings"
END

CONTROLBAR:ObsLabelKills
"Kills"
END

CONTROLBAR:ObsLabelLosses
"Losses"
END

